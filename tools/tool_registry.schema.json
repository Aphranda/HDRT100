{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hdrt100:tools-registry:v1",
  "title": "Repository tool-family registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {"const": 1},
    "tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "^[^|\\r\\n]+$", "not": {"pattern": "[\\r\\n]"}},
    "path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$", "not": {"pattern": "[\\r\\n]"}},
    "tool_id": {"type": "string", "pattern": "^TOOL-[A-Z0-9]+(?:-[A-Z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}},
    "paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "role"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "role": {"enum": ["entrypoint", "module", "compatibility_wrapper", "test_runner", "resource", "documentation"]}
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "purpose", "domain", "owner", "lifecycle", "operation", "entrypoints", "files", "depends_on", "external_dependencies", "dependency_review", "aliases", "validation", "handoff_evidence", "notes"],
      "properties": {
        "id": {"$ref": "#/$defs/tool_id"},
        "purpose": {"$ref": "#/$defs/text"},
        "domain": {"$ref": "#/$defs/text"},
        "owner": {"$ref": "#/$defs/text"},
        "lifecycle": {"enum": ["UNASSESSED", "EXPERIMENTAL", "SUPPORTED", "DEPRECATED", "ARCHIVED"]},
        "operation": {"enum": ["UNASSESSED", "OFFLINE", "DEVICE_READ", "DEVICE_CONFIGURE", "DEVICE_PROGRAM", "MIXED"]},
        "entrypoints": {"$ref": "#/$defs/paths"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/tool_id"}},
        "external_dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "dependency_review": {"enum": ["PENDING", "COMPLETE"]},
        "aliases": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "target"],
            "properties": {"path": {"$ref": "#/$defs/path"}, "target": {"$ref": "#/$defs/path"}}
          }
        },
        "validation": {"$ref": "#/$defs/paths"},
        "handoff_evidence": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
        "notes": {"$ref": "#/$defs/text"}
      }
    }
  }
}
