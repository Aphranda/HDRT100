<UserControl x:Class="DhrT100.SequenceDebug.App.FieldBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Margin="0,0,10,0">
    <StackPanel>
        <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="TextPart" MinWidth="80"
                 Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ComboBox x:Name="ComboPart" MinWidth="80" Visibility="Collapsed"
                  ItemsSource="{Binding Options, ElementName=Root}"
                  SelectedItem="{Binding Value, ElementName=Root, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
