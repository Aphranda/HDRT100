<Window x:Class="DhrT100.SequenceDebug.App.LoopbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="760" Height="300" MinWidth="740" MinHeight="280"
        Background="{StaticResource WindowBackground}"
        FontFamily="Microsoft YaHei UI" FontSize="12" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Wiring}" Style="{StaticResource Hint}" Margin="0,0,0,6" />
        <TextBlock Text="{Binding ReceiverNote}" Style="{StaticResource Hint}" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="观察时长（秒）" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBox Width="80" Text="{Binding Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="填入回环预设" Margin="0,0,6,0" Command="{Binding ApplyPresetCommand}" />
            <Button Content="配置此模式" Margin="0,0,6,0" Command="{Binding ConfigureCommand}" />
            <Button Content="启动并观察" Margin="0,0,6,0" Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartCommand}" />
            <Button Content="停止" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
    </StackPanel>
</Window>
