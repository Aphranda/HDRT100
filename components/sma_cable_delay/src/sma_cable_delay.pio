.program sma_cable_delay_source
.wrap_target
    set pins, 1
    set pins, 0
.wrap

.program sma_cable_delay_capture
.wrap_target
    in pins, 4
.wrap

; Reference source protocol: a 16 ns mark, then a 40 ns appointment gap.
; The source and validator use symmetric IRQ handoff paths after mark end.
.program sma_cable_delay_source_appointment_mark
    set pins, 1 [3]
    set pins, 0 [7]
    irq set 0
mark_halt:
    jmp mark_halt

.program sma_cable_delay_source_appointed
    wait 1 irq 0
    irq clear 0
.wrap_target
    set pins, 1
    set pins, 0
.wrap

.program sma_cable_delay_capture_appointment_mark
wait_mark_high:
    jmp pin wait_mark_low
    jmp wait_mark_high
wait_mark_low:
    jmp pin wait_mark_low
    nop [7]
    irq set 0
capture_mark_halt:
    jmp capture_mark_halt

.program sma_cable_delay_capture_appointed
    wait 1 irq 0
    irq clear 0
.wrap_target
    in pins, 4
.wrap

; Initiator emits a 16 ns request mark and then samples the return input on
; every 250 MHz PIO cycle.  Sample zero is one cycle after the request falling
; edge, so the C adapter reports raw_round_trip_cycles = sample_index + 1.
.program sma_cable_delay_rtt_initiator
    set pins, 1 [3]
    set pins, 0
.wrap_target
    in pins, 1
.wrap

; Responder detects the complete request mark, waits a fixed 10-cycle
; falling-edge-to-rising-edge turnaround, emits a 16 ns response, and signals
; completion.  The fixed delay stays entirely inside PIO.
.program sma_cable_delay_rtt_responder
    wait 1 pin 0
    wait 0 pin 0
    nop [8]
    set pins, 1 [3]
    set pins, 0
    irq set 0
rtt_responder_halt:
    jmp rtt_responder_halt

% c-sdk {

static inline void sma_cable_delay_source_program_init(PIO pio,
                                                        uint sm,
                                                        uint offset,
                                                        uint output_pin,
                                                        float clkdiv)
{
    pio_gpio_init(pio, output_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, output_pin, 1u, true);

    pio_sm_config config =
        sma_cable_delay_source_program_get_default_config(offset);
    sm_config_set_set_pins(&config, output_pin, 1u);
    sm_config_set_clkdiv(&config, clkdiv);
    pio_sm_init(pio, sm, offset, &config);
    pio_sm_set_pins(pio, sm, 0u);
}

static inline void sma_cable_delay_capture_program_init(PIO pio,
                                                         uint sm,
                                                         uint offset,
                                                         uint input_base_pin)
{
    for (uint pin = input_base_pin; pin < input_base_pin + 4u; ++pin) {
        pio_gpio_init(pio, pin);
    }
    pio_sm_set_consecutive_pindirs(pio,
                                   sm,
                                   input_base_pin,
                                   4u,
                                   false);

    pio_sm_config config =
        sma_cable_delay_capture_program_get_default_config(offset);
    sm_config_set_in_pins(&config, input_base_pin);
    sm_config_set_in_shift(&config, false, true, 32u);
    sm_config_set_fifo_join(&config, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&config, 1.0f);
    pio_sm_init(pio, sm, offset, &config);
}

static inline void sma_cable_delay_source_appointment_mark_program_init(
    PIO pio,
    uint sm,
    uint offset,
    uint output_pin)
{
    pio_gpio_init(pio, output_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, output_pin, 1u, true);
    pio_sm_config config =
        sma_cable_delay_source_appointment_mark_program_get_default_config(
            offset);
    sm_config_set_set_pins(&config, output_pin, 1u);
    sm_config_set_clkdiv(&config, 1.0f);
    pio_sm_init(pio, sm, offset, &config);
    pio_sm_set_pins(pio, sm, 0u);
}

static inline void sma_cable_delay_source_appointed_program_init(
    PIO pio,
    uint sm,
    uint offset,
    uint output_pin,
    float clkdiv)
{
    pio_gpio_init(pio, output_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, output_pin, 1u, true);
    pio_sm_config config =
        sma_cable_delay_source_appointed_program_get_default_config(offset);
    sm_config_set_set_pins(&config, output_pin, 1u);
    sm_config_set_clkdiv(&config, clkdiv);
    pio_sm_init(pio, sm, offset, &config);
    pio_sm_set_pins(pio, sm, 0u);
}

static inline void sma_cable_delay_capture_appointment_mark_program_init(
    PIO pio,
    uint sm,
    uint offset,
    uint marker_pin)
{
    pio_gpio_init(pio, marker_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, marker_pin, 1u, false);
    pio_sm_config config =
        sma_cable_delay_capture_appointment_mark_program_get_default_config(
            offset);
    sm_config_set_jmp_pin(&config, marker_pin);
    sm_config_set_clkdiv(&config, 1.0f);
    pio_sm_init(pio, sm, offset, &config);
}

static inline void sma_cable_delay_capture_appointed_program_init(
    PIO pio,
    uint sm,
    uint offset,
    uint input_base_pin)
{
    for (uint pin = input_base_pin; pin < input_base_pin + 4u; ++pin) {
        pio_gpio_init(pio, pin);
    }
    pio_sm_set_consecutive_pindirs(pio, sm, input_base_pin, 4u, false);
    pio_sm_config config =
        sma_cable_delay_capture_appointed_program_get_default_config(offset);
    sm_config_set_in_pins(&config, input_base_pin);
    sm_config_set_in_shift(&config, false, true, 32u);
    sm_config_set_fifo_join(&config, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&config, 1.0f);
    pio_sm_init(pio, sm, offset, &config);
}

static inline void sma_cable_delay_rtt_initiator_program_init(
    PIO pio,
    uint sm,
    uint offset,
    uint output_pin,
    uint response_input_pin)
{
    pio_gpio_init(pio, output_pin);
    pio_gpio_init(pio, response_input_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, output_pin, 1u, true);
    pio_sm_set_consecutive_pindirs(pio, sm, response_input_pin, 1u, false);
    pio_sm_config config =
        sma_cable_delay_rtt_initiator_program_get_default_config(offset);
    sm_config_set_set_pins(&config, output_pin, 1u);
    sm_config_set_in_pins(&config, response_input_pin);
    sm_config_set_in_shift(&config, false, true, 32u);
    sm_config_set_fifo_join(&config, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&config, 1.0f);
    pio_sm_init(pio, sm, offset, &config);
    pio_sm_set_pins(pio, sm, 0u);
}

static inline void sma_cable_delay_rtt_responder_program_init(
    PIO pio,
    uint sm,
    uint offset,
    uint request_input_pin,
    uint output_pin)
{
    pio_gpio_init(pio, request_input_pin);
    pio_gpio_init(pio, output_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, request_input_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, output_pin, 1u, true);
    pio_sm_config config =
        sma_cable_delay_rtt_responder_program_get_default_config(offset);
    sm_config_set_in_pins(&config, request_input_pin);
    sm_config_set_set_pins(&config, output_pin, 1u);
    sm_config_set_clkdiv(&config, 1.0f);
    pio_sm_init(pio, sm, offset, &config);
    pio_sm_set_pins(pio, sm, 0u);
}

%}
