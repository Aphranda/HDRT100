/* Schema 2 appends diagnostic-only observer data; preserve the V1 prefix. */
RECORD_U32(event, state, phys.event.state)
RECORD_U32(event, reason, phys.event.reason)
RECORD_U32(event, epoch, phys.event.epoch)
RECORD_U32(event, waiting, phys.event.waiting)
