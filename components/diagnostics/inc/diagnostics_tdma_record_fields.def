RECORD_U64(event, tx_elapsed_cycles, phys.event.tx_elapsed_cycles)
RECORD_U64(event, start_width_cycles, phys.event.start_width_cycles)
/* V3 appends a historical candidate attempt; no timestamp or DPLL authority. */
RECORD_U32(candidate, query_count, phys.event.candidate.query_count)
RECORD_U32(candidate, matched_count, phys.event.candidate.matched_count)
RECORD_U32(candidate, unavailable_count, phys.event.candidate.unavailable_count)
