RECORD_U32(origin_first, arm_padout, origin_first.record.raw_time.arm_padout)
RECORD_U32(origin_first, tick_hz, origin_first.record.raw_time.tick_hz)
RECORD_U32(origin_first, sequence_end, origin_first.record.sequence_end)
/* V5 appends one guarded first-RX diagnostic archive. Component flags, not
 * availability, state copy/event outcomes; neither confers time authority.
 * Raw words encode four wire-order bytes little-endian, with zero padding. */
RECORD_U32(rx_first, available, rx_first_available)
RECORD_U32(rx_first, raw_capacity, rx_first_available ? TDMA_RX_FIRST_WINDOW_RAW_CAPACITY : 0u)
