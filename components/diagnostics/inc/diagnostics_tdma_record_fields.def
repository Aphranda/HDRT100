/* V4 appends the immutable first autonomous raw record. Availability is local
 * copy integrity only, independent of transport flags, edge presence and VDC
 * qualification. Ordinary/follower/READY samples normally have available=0. */
RECORD_U32(origin_first, available, origin_first_available)
RECORD_U32(origin_first, published_version, origin_first.published_version)
RECORD_U32(origin_first, sequence, origin_first.record.observation.sequence)
RECORD_U32(origin_first, identity, origin_first.record.observation.identity)
RECORD_U32(origin_first, local_generation, origin_first.record.observation.local_generation)
RECORD_U32(origin_first, output_remaining, origin_first.record.observation.output_remaining)
RECORD_U32(origin_first, rtt_remaining, origin_first.record.observation.rtt_remaining)
RECORD_U32(origin_first, rtt_present, origin_first.record.observation.rtt_present)
RECORD_U32(origin_first, capture_remaining, origin_first.record.capture_remaining)
RECORD_U32(origin_first, returned_trailer, origin_first.record.returned_trailer)
RECORD_U32(origin_first, epoch, origin_first.record.epoch)
RECORD_U32(origin_first, flags, origin_first.record.flags)
RECORD_U32(origin_first, format, origin_first.record.format)
RECORD_U32(origin_first, arm_before_hi0, origin_first.record.raw_time.arm_before[0])
RECORD_U32(origin_first, arm_before_lo, origin_first.record.raw_time.arm_before[1])
RECORD_U32(origin_first, arm_before_hi1, origin_first.record.raw_time.arm_before[2])
RECORD_U32(origin_first, arm_after_hi0, origin_first.record.raw_time.arm_after[0])
RECORD_U32(origin_first, arm_after_lo, origin_first.record.raw_time.arm_after[1])
RECORD_U32(origin_first, arm_after_hi1, origin_first.record.raw_time.arm_after[2])
RECORD_U32(origin_first, latch_remaining, origin_first.record.raw_time.latch_remaining)
