.pio_version 1

; STATUS reads this block's READY IRQ. Rejected edges are never queued.
.program sequence_ingress
.wrap_target
public inactive:
    wait 0 pin 0
public active:
    wait 1 pin 0
public observed:
    mov x, status
public decide:
    jmp !x inactive
public admitted:
    irq clear 4
public request:
    irq set 5
.wrap

; Finite admission preserves the quota across busy edges. Y is initialized to
; max_steps - 1; the last admitted request falls through to a permanent park.
.program sequence_finite_ingress
.wrap_target
public inactive:
    wait 0 pin 0
public active:
    wait 1 pin 0
public observed:
    mov x, status
public decide:
    jmp !x inactive
public admitted:
    irq clear 4
public request:
    irq set 5
public quota:
    jmp y-- inactive
public parked:
    jmp parked
.wrap

; Each plan item is {packed normal/tag/active values, settle countdown, pulse
; countdown}. LEVEL/NONE patch the status-mode instruction to skip the pulse.
; RX autopush makes the written receipt one instruction, preserving one word
; of space for the finite input quota and the existing capture persona.
.program sequence_executor
.wrap_target
    pull block
    mov y, osr
    pull block
    mov x, osr
    irq set 4
public waiting:
    wait 1 irq 5
public writing:
    mov pins, y
public written:
    in y, 32 ; autopush, preserving receipt backpressure
public settling:
    jmp x-- settling
    mov osr, y
    out null, 12
    out pins, 4
    pull block
public status_mode:
    mov x, osr
public pulsing:
    jmp x-- pulsing
    mov pins, y
public status_active:
    mov isr, ~y
public completed:
    push block
.wrap

; X starts at all ones. Lost FIFO snapshots do not lose cumulative edges.
.program sequence_counter
.wrap_target
public inactive:
    wait 0 pin 0
public active:
    wait 1 pin 0
public observed:
    jmp x-- counted
public counted:
    mov isr, ~x
    push noblock
.wrap

; Replaces ingress in combined MANUAL/NONE mode. SET maps only the gateway pin;
; the independent executor is idle for the complete pulse. At 10 MHz the
; high interval is countdown + 2 ticks. READY counter runs concurrently.
.program sequence_gateway
.wrap_target
    pull block
    mov x, osr
    set pins, 1
public pulsing:
    jmp x-- pulsing
    set pins, 0
    push noblock
.wrap
