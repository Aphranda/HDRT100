.pio_version 1

; STATUS reads this block's READY IRQ. Rejected edges are never queued.
.program sequence_ingress
.wrap_target
public inactive:
    wait 0 pin 0
public active:
    wait 1 pin 0
public observed:
    mov x, status
public decide:
    jmp !x inactive
public admitted:
    irq clear 4
public request:
    irq set 5
.wrap

; Finite admission preserves the quota across busy edges. Y is initialized to
; max_steps - 1; the last admitted request falls through to a permanent park.
.program sequence_finite_ingress
.wrap_target
public inactive:
    wait 0 pin 0
public active:
    wait 1 pin 0
public observed:
    mov x, status
public decide:
    jmp !x inactive
public admitted:
    irq clear 4
public request:
    irq set 5
public quota:
    jmp y-- inactive
public parked:
    jmp parked
.wrap

; Each plan item is {packed normal/tag/active values, settle countdown, pulse
; countdown}. LEVEL/NONE patch the status-mode instruction to skip the pulse.
; RX autopush makes the written receipt one instruction, preserving one word
; of space for the finite input quota and the existing capture persona.
.program sequence_executor
.wrap_target
    pull block
    mov y, osr
    pull block
    mov x, osr
public admission:
    irq set 4
public waiting:
    wait 1 irq 5
public writing:
    mov pins, y
public written:
    in y, 32 ; autopush, preserving receipt backpressure
public settling:
    jmp x-- settling
public status_prepare:
    mov osr, y
    out null, 12
    out pins, 4
    pull block
public status_mode:
    mov x, osr
public pulsing:
    jmp x-- pulsing
    mov pins, y
public status_active:
    mov isr, ~y
public completed:
    push block
.wrap

; X starts at all ones. Lost FIFO snapshots do not lose cumulative edges.
.program sequence_counter
.wrap_target
public inactive:
    wait 0 pin 0
public active:
    wait 1 pin 0
public observed:
    jmp x-- counted
public counted:
    mov isr, ~x
    push noblock
.wrap

; The combined DUT needs only code, settle and two receipts. Consume the
; third plan word to preserve the DMA/receipt contract used by the full path.
.program sequence_none_executor
.wrap_target
    pull block
    mov y, osr
    pull block
    mov x, osr
    irq set 4
public waiting:
    wait 1 irq 5
public writing:
    mov pins, y
public written:
    in y, 32
public settling:
    jmp x-- settling
    pull block
public status_active:
    mov isr, ~y
public completed:
    push block
.wrap

; One grant admits one complete READY edge. WAIT IRQ acknowledges the grant;
; gateway delays two synchronized PIO ticks before its output rises, allowing
; an initially inactive input to reach the active WAIT first. An already-active
; READY still waits inactive->active; it never prevents the trigger output.
.program sequence_ready_counter
.wrap_target
public grant:
    wait 1 irq 6
public inactive:
    wait 0 pin 0
public active:
    wait 1 pin 0
public observed:
    jmp x-- counted
public counted:
    mov isr, ~x
    push block
.wrap

; Replaces ingress in combined MANUAL/NONE mode. IRQ6 is internal to PIO0,
; never a CPU interrupt. Manual READY patches grant to NOP [2]. At 250 MHz
; the high interval remains countdown + 2 ticks; grant delay is before high.
.program sequence_gateway
.wrap_target
    pull block
    mov x, osr
public grant:
    irq wait 6 [2]
    set pins, 1
public pulsing:
    jmp x-- pulsing
    set pins, 0
    push block
.wrap
