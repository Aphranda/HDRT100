; Y is preloaded with pulse_ticks-2 while disabled. TX supplies delay.
; Rising edge = SM origin + delay + 4 clocks. IRQ6 informs READY but NEVER
; waits for it. Pulse completion pushes preloaded ISR transaction sequence.
.program sync_gateway_output
.wrap_target
    pull block
    out x, 32
delay:
    jmp x-- delay
    irq 6
    set pins, 1
high:
    jmp y-- high
    set pins, 0
    push block
.wrap

; A grant accepts one NEW low->high READY transition. Initial high is not READY.
.program sync_gateway_ready
.wrap_target
    wait 1 irq 6
    wait 0 pin 0
    wait 1 pin 0
    jmp x-- counted
counted:
    mov isr, ~x
    push block
.wrap
