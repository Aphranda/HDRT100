.program tdma_pio_spi_tx_byte
.side_set 1

.wrap_target
    pull block        side 0
    set x, 7         side 0
bitloop:
    ; Six PIO cycles per bit: three low and three high. DATA changes at the
    ; beginning of the low phase, remains stable for two PIO cycles before the
    ; rising sampling edge, and stays stable through the complete high phase.
    out pins, 1      side 0 [1]
    nop              side 1 [2]
    jmp x-- bitloop  side 0
.wrap

.program tdma_pio_spi_rx_byte

; Standard pico-examples-style SPI slave receive loop: sample MOSI on SCK high,
; autopush every 8 bits (in_shift autopush threshold = 8). No manual X counter
; -- the hardware shifts and pushes each byte, so the byte boundary cannot
; drift with loop timing.
.wrap_target
    wait 0 gpio 0
    wait 1 gpio 1
    in pins, 1
    wait 0 gpio 1
.wrap

; SPI CLK foundation training follower. The upstream RX CLK is regenerated
; directly onto the downstream TX CLK. DATA and frame-sync/CS are deliberately
; outside this first-stage path.
.program tdma_pio_spi_clk_forward
.wrap_target
    wait 0 gpio 0
    wait 1 gpio 0
    set pins, 1
    wait 0 gpio 0
    set pins, 0
.wrap

; SPI CLK foundation training master. One FIFO word contains pulse_count - 1;
; the SM emits the complete burst without core intervention and sets PIO IRQ 1
; after the final falling edge. Four PIO cycles form one CLK period. IRQ 2 is
; owned by the return detector: if it was already set when the burst ends,
; the SM parks before setting IRQ 1. Therefore IRQ2=1/IRQ1=0 is a hardware
; ordered overlap result, while IRQ2=1/IRQ1=1 means the return arrived after
; TX completion.
.program tdma_pio_spi_clk_burst
.side_set 1
.wrap_target
    pull block          side 0
    mov x, osr          side 0
clk_burst_loop:
    nop                 side 1 [1]
    jmp x-- clk_burst_loop side 0 [1]
    wait 0 irq 2        side 0
    irq set 1           side 0
.wrap

; Master return detector. IRQ 2 means a returned RX CLK edge was seen. The
; burst SM above performs the ordering decision fully in PIO timing. IRQ 3 is
; a host-owned release gate which keeps this detector from accepting a second
; edge from the same epoch.
.program tdma_pio_spi_clk_capture
.wrap_target
    wait 0 gpio 0
    wait 1 gpio 0
    irq set 2
    wait 1 irq 3
.wrap

; Second-stage coded calibration TX. One raw Manchester sample is emitted per
; clk_sys cycle. The TX DMA supplies packed samples through autopull; core1
; never feeds individual edges.
.program tdma_pio_spi_clk_coded_tx
.wrap_target
    out pins, 1
.wrap

; Product cyclic follower for the actual three-line wiring: CS/SCK travel
; toward the next node while DATA returns toward the previous node.  The SM
; forwards SCK with side-set, captures the downstream DATA byte into RX FIFO,
; and emits the previously captured byte on the upstream DATA driver.  The
; one-byte elastic delay preserves byte alignment and removes core service
; from the wire path.  A separate marker_forward SM owns CS forwarding.
.program tdma_pio_spi_flight_follower
.side_set 1
    set y, 0             side 0
    mov osr, y           side 0
    out null, 24         side 0
.wrap_target
    set x, 7             side 0
flight_follower_bit:
    wait 1 gpio 0        side 0
    nop                  side 1
    in pins, 1           side 1
    wait 0 gpio 0        side 1
    out pins, 1          side 0
    jmp x-- flight_follower_bit side 0
    mov osr, isr         side 0
    push noblock         side 0
    out null, 24         side 0
    mov isr, null        side 0
.wrap

; Process-image follower. TX DMA supplies one command word per physical byte:
; bit31 REPLACE, bit30 END, bits29..22 replacement data. PASS keeps the
; existing one-byte elastic forwarding behavior. END is consumed after the
; final tail byte and holds the SM at the next CS boundary until the following
; frame script is ready; core1 never services an individual wire edge.
.program tdma_pio_spi_flight_process_follower
.wrap_target
flight_process_command:
    pull block
    ; PASS is the hot path: a zero first bit branches directly to the saved
    ; tail byte. REPLACE/END consume the second bit only on the slow path.
    out x, 1
    jmp !x flight_process_pass
    out x, 1
    jmp !x flight_process_byte
    ; Keep Y across CS boundaries. The first PASS byte of the next physical
    ; frame must emit the preceding tail byte to preserve the continuous
    ; one-byte elastic pipeline; ARM/restart initializes Y exactly once.
    ; Raise the boundary as soon as the completed frame releases CS. The next
    ; command PULL is the inter-frame gate, so waiting for the following CS
    ; falling edge here only shortens the core1 preparation window.
    wait 1 gpio 0
    ; IRQ3 is the physical frame-boundary evidence consumed by core1. If
    ; the just-finished raw frame cannot be decoded, core1 still queues one
    ; PASS script before the following frame instead of leaving this SM
    ; permanently blocked at PULL. The explicit jump is required: hardware
    ; wrap occurs only after the final PUSH, so falling through here would
    ; execute PASS once without consuming a command and add one RX word per
    ; physical frame.
    irq set 3
    jmp flight_process_command
flight_process_pass:
    ; Y retains the byte captured during the preceding command. PUSH does not
    ; provide storage for the next PASS command, because ISR must be cleared
    ; before sampling the current byte.
    mov osr, y
    out null, 24
flight_process_byte:
    set y, 7
flight_process_bit:
    wait 1 gpio 1
    in pins, 1
    wait 0 gpio 1
    out pins, 1
    jmp y-- flight_process_bit
    mov y, isr
    push noblock
    ; PUSH resets the input shift count. Stale upper ISR bits are irrelevant:
    ; the next eight left shifts replace the low byte used by PASS and RX DMA.
.wrap

; Process-image control follower.  CS and SCK remain independent of overlay
; command timing and DATA contents.  Core1 primes the fixed physical bit count
; once at ARM; OSR retains that count across frames.  GPIO25/26 are contiguous,
; so SET pins writes {CS,SCK}: 2=idle, 0=active/low, 1=active/high.
.program tdma_pio_spi_flight_control_forward
    pull block
.wrap_target
    wait 0 gpio 0
    set pins, 0
    mov x, osr
flight_control_bit:
    wait 1 gpio 1
    ; Apply the trained SCK phase to both physical edges.  Keeping the two
    ; delays symmetric preserves the incoming duty cycle while translating
    ; the complete clock waveform onto this node's outgoing link.
    set pins, 1
    wait 0 gpio 1
    set pins, 0
    jmp x-- flight_control_bit
    wait 1 gpio 0
    set pins, 2
.wrap

; Diagnostic-only raw flight SCK capture. The SM starts on the first physical
; RX SCK rising edge, then samples RX SCK every clk_sys cycle. Autopush and the
; joined eight-word RX FIFO retain 256 raw samples (1.024 us at 250 MHz)
; without another DMA channel or any core intervention in the edge path.
.program tdma_pio_spi_flight_sck_capture
    wait 0 gpio 0
    wait 1 gpio 0
.wrap_target
    in pins, 1
.wrap

; Reference-node hardware RTT latch. The host supplies UINT32_MAX before each
; launch. TX CS falling starts the counter; RX CS falling stops it and pushes
; the remaining count. The high-path loop is exactly two clk_sys cycles, so
; the edge interval has 8 ns resolution at 250 MHz and contains no core code.
.program tdma_pio_spi_flight_origin_rtt
.wrap_target
flight_origin_rtt_restart:
    pull block
    mov x, osr
    wait 1 gpio 0
    wait 0 gpio 0
flight_origin_rtt_count:
    jmp pin flight_origin_rtt_high
    mov isr, x
    push block
    jmp flight_origin_rtt_restart
flight_origin_rtt_high:
    jmp x-- flight_origin_rtt_count
.wrap

; Cyclic reference clock source. Core1 supplies the total clock-bit count
; minus one. Returned DATA is captured by origin_data_tx against the real
; returned CS/SCK, so the byte boundary does not depend on local loop phase.
.program tdma_pio_spi_flight_origin_clock_rx
.side_set 1
.wrap_target
    pull block           side 0
    mov x, osr           side 0
flight_origin_clock_bit:
    nop                  side 0 [1]
    nop                  side 1 [2]
    jmp x-- flight_origin_clock_bit side 0
    irq set 1            side 0
.wrap

; Cyclic reference DATA source.  The complete frame is preloaded by DMA.  The
; SM waits for the real CS/SCK that has traversed the forward loop, then emits
; DATA in the electrically correct reverse direction without a core1 edge in
; the timing path.
.program tdma_pio_spi_flight_origin_data_tx
.wrap_target
    ; Core1 queues wire_bytes-1 before the frame payload.  Wait for returned
    ; CS once per frame, then let Y keep the inner byte loop away from CS.
    wait 1 gpio 0
    wait 0 gpio 0
    pull block
    mov y, osr
flight_origin_data_byte:
    pull block
    set x, 7
flight_origin_data_bit:
    wait 0 gpio 1
    out pins, 1
    wait 1 gpio 1
    nop
    in pins, 1
    jmp x-- flight_origin_data_bit
    jmp y-- flight_origin_data_byte
.wrap

; Second-stage coded calibration RX. One returned CLK sample is captured per
; clk_sys cycle and autopushed in packed 32-sample words to the RX DMA.
.program tdma_pio_spi_clk_oversample
.wrap_target
    in pins, 1
.wrap

; TRN-01 CS marker forwarding.  CS is electrically idle high.  The first
; observable marker event is therefore its falling Manchester transition;
; regenerate both levels with a fixed PIO-only cut-through path.
.program tdma_pio_spi_marker_forward
.wrap_target
    wait 1 gpio 0
    wait 0 gpio 0
    set pins, 0
    wait 1 gpio 0
    set pins, 1
.wrap

; Node0 marker injection. The first TX FIFO word is the one-shot virtual
; rx_csn event that starts an idle ring. The output remains at its configured
; high-idle latch until that word is available. Node0 RX still waits for the
; real upstream rx_csn after the marker traverses the complete loop.
.program tdma_pio_spi_marker_origin
    pull block
.wrap_target
    out pins, 1
.wrap

; TRN-01 marker capture.  Two adjacent pins are sampled per clk_sys cycle:
; bit 0 is downstream CS (GPIO26), bit 1 is upstream CS (GPIO27).  Followers
; wait for the first upstream falling edge; the originator waits for its local
; TX falling edge.  DMA therefore records every node from a PIO-owned marker
; edge without a core timestamp in the edge path.
.program tdma_pio_spi_marker_capture
    wait 1 gpio 0
    wait 0 gpio 0
.wrap_target
    in pins, 2
.wrap

; TRN-02 DATA responder. Core1 preloads the marker-to-DATA delay cycles minus
; one before starting the DATA DMA. OUT is the one-instruction wrap body, so
; every raw DATA bit occupies exactly one clk_sys cycle. After the final DMA
; word, autopull stalls on the empty FIFO and the sticky TXSTALL bit proves
; that the last physical bit has left the OSR.
; The SM waits for the incoming RX CS falling edge, holds the DATA output at its
; low idle level for the complete PIO-owned delay, then emits one raw sample
; per clk_sys cycle.
.program tdma_pio_spi_data_train_source
    pull block
    mov x, osr
    out null, 32
    wait 1 gpio 0
    wait 0 gpio 0
data_train_source_wait:
    jmp x-- data_train_source_wait
    nop
.wrap_target
data_train_source_samples:
    out pins, 1
.wrap

; TRN-02 DATA initiator capture. Core1 preloads the same long delay used by the
; responder. The patched NOP adds the round-trip link baseline plus the dynamic
; search-window start. The initiator's local TX CS falling edge opens the gate;
; RX DMA then records the returning DATA without software timing in the path.
.program tdma_pio_spi_data_train_sink
    pull block
    mov x, osr
    wait 1 gpio 0
    wait 0 gpio 0
data_train_sink_wait:
    jmp x-- data_train_sink_wait
    nop
.wrap_target
    in pins, 1
.wrap

; Independent SCK training follows the CS PIO launch sequence, but the local
; CS pin is used only as an internal source gate. Its driver stays disabled, so
; no MARK/CS edge reaches the cable or participates in SCK measurement.
.program tdma_pio_spi_sck_train_trigger
    pull block
.wrap_target
    out pins, 1
.wrap

; Core1 preloads the quiet launch guard minus one into the source FIFO. The
; source waits for the local PIO CS launch edge, holds a physical SCK origin
; pulse for the same bounded interval, returns SCK low, applies the guard, then
; emits the complete known SCK codeword.  The destination anchors capture on
; the origin falling edge, matching the robust CS edge sequence without using
; CS itself as the SCK timing reference.
.program tdma_pio_spi_sck_train_source
    pull block
    mov x, osr
    out null, 32
    mov y, x
    wait 1 gpio 0
    wait 0 gpio 0
    set pins, 1
sck_train_source_origin_wait:
    jmp y-- sck_train_source_origin_wait
    set pins, 0
sck_train_source_wait:
    jmp x-- sck_train_source_wait
    nop
.wrap_target
    out pins, 1
.wrap

; The destination establishes its origin from SCK itself: it qualifies the
; physical RX SCK rising level, anchors on the following falling edge, applies
; the patched phase delay, then captures one raw sample per clk_sys cycle.
; CS/MARK is not observed.
.program tdma_pio_spi_sck_train_sink
    wait 0 gpio 0
    wait 1 gpio 0
    wait 0 gpio 0
    nop
.wrap_target
    in pins, 1
.wrap

; P3 link initiator. SYNC is asserted for the complete forward burst. Four PIO
; cycles form one forward-line period with two high and two low cycles. The RX SM is
; enabled in sync with this SM and samples the returned DATA pin at clk_sys.
.program tdma_pio_spi_p3_initiator
.side_set 1
.wrap_target
    pull block              side 0
    set pins, 1             side 0
    mov x, osr              side 0
p3_clk_loop:
    nop                     side 1 [1]
    jmp x-- p3_clk_loop     side 0 [1]
    set pins, 0             side 0
    irq set 1               side 0
.wrap

; P3 link responder. The init function patches the sync and forward-line WAIT
; GPIO operands plus the DATA-high delay. t2 is the accepted forward-line
; rising edge; t3 is the following SET DATA instruction, so residence is one
; clk_sys cycle. DATA high duration is rounded to the closest clk_sys cycle.
.program tdma_pio_spi_p3_responder
.wrap_target
    wait 0 gpio 0
    wait 1 gpio 0
    wait 0 gpio 1
    wait 1 gpio 1
    set pins, 1
    set pins, 0
    irq set 1
.wrap

; P3 responder capture starts only after the incoming SYNC edge so it may be
; armed by the host well before the initiator without exhausting its DMA
; window. It then records GPIO24..31 exactly like the local loopback capture.
.program tdma_pio_spi_p3_responder_capture
    wait 0 gpio 0
    wait 1 gpio 0
.wrap_target
    in pins, 8
.wrap

; Single-board calibration persona. GPIO25..29 map to CLK_TX, SYNC_TX,
; SYNC_RX, CLK_RX and DATA_TX; only 25/26/29 are configured as outputs.
; The returned DATA_RX is GPIO24. The waveform is autonomous and bounded.
.program tdma_pio_spi_cal_loopback_tx
.wrap_target
    set pins, 0  [31] ; leading quiet lets capture establish initial state
    set pins, 2  [31] ; SYNC_TX rising marker
    set pins, 1  [31] ; CLK_TX rising edge (t1)
    set pins, 0  [31]
    set pins, 16 [31] ; DATA_TX rising edge (t3)
    set pins, 0  [31]
    irq set 1
.wrap

; Sample GPIO24..31 as one byte. The capture DMA packs four successive PIO
; samples into one word. GPIO30/31 remain SIO-owned driver-enable pins; IN
; observes their pad levels without changing their function or direction.
.program tdma_pio_spi_cal_loopback_capture
.wrap_target
    in pins, 8
.wrap

; Full-duplex master: drives SCK + MOSI while sampling MISO on the same
; exchange. Each byte is pulled from TX FIFO, shifted out on MOSI, sampled on
; MISO and pushed to RX FIFO (one SPI transfer per byte).
.program tdma_pio_spi_fd_master
.side_set 1
.wrap_target
    pull block        side 0
    set x, 7          side 0
bitloop_fd:
    out pins, 1       side 0 [1]
    in pins, 1        side 1 [1]
    jmp x-- bitloop_fd side 0 [1]
    push block        side 0
.wrap

; Full-duplex slave: samples MOSI on the master clock while driving MISO with
; the response byte from TX FIFO (one SPI transfer per byte).
.program tdma_pio_spi_fd_slave
.wrap_target
    wait 0 gpio 0
    pull block
    set x, 7
bitloop_fds:
    wait 1 gpio 1
    in pins, 1
    out pins, 1
    wait 0 gpio 1
    jmp x-- bitloop_fds
    push block
.wrap

% c-sdk {

#include <stdbool.h>
#include <stdint.h>

#include "hardware/clocks.h"
#include "hardware/pio_instructions.h"

static inline float tdma_pio_spi_clkdiv_for_baud(uint32_t baud_hz)
{
    const uint32_t bit_cycles = 6u;
    const uint32_t effective_baud = baud_hz == 0u ? 25000000u : baud_hz;
    return (float)clock_get_hz(clk_sys) / (float)(effective_baud * bit_cycles);
}

static inline void tdma_pio_spi_tx_byte_program_init(PIO pio,
                                                     uint sm,
                                                     uint offset,
                                                     uint tx_pin,
                                                     uint sck_pin,
                                                     uint32_t baud_hz)
{
    pio_gpio_init(pio, tx_pin);
    pio_gpio_init(pio, sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, sck_pin, 1, true);

    pio_sm_config c = tdma_pio_spi_tx_byte_program_get_default_config(offset);
    sm_config_set_out_pins(&c, tx_pin, 1);
    sm_config_set_sideset_pins(&c, sck_pin);
    sm_config_set_out_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, tdma_pio_spi_clkdiv_for_baud(baud_hz));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins(pio, sm, 0);
}

static inline void tdma_pio_spi_rx_byte_program_init(PIO pio,
                                                     uint sm,
                                                     uint offset,
                                                     uint rx_pin,
                                                     uint csn_pin,
                                                     uint sck_pin)
{
    /* Standard autopush layout: instruction 0 is the CS wait (patched to
     * nop on the ring), 1 is "wait SCK high", 3 is "wait SCK low". */
    pio->instr_mem[offset + 0u] =
        csn_pin == UINT32_MAX
            ? (uint16_t)pio_encode_nop()
            : (uint16_t)pio_encode_wait_gpio(false, csn_pin);
    pio->instr_mem[offset + 1u] = (uint16_t)pio_encode_wait_gpio(true, sck_pin);
    pio->instr_mem[offset + 3u] = (uint16_t)pio_encode_wait_gpio(false, sck_pin);

    pio_gpio_init(pio, rx_pin);
    if (csn_pin != UINT32_MAX) {
        pio_gpio_init(pio, csn_pin);
    }
    pio_gpio_init(pio, sck_pin);
    gpio_pull_down(rx_pin);
    if (csn_pin != UINT32_MAX) {
        gpio_pull_up(csn_pin);
    }
    gpio_pull_down(sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_pin, 1, false);
    if (csn_pin != UINT32_MAX) {
        pio_sm_set_consecutive_pindirs(pio, sm, csn_pin, 1, false);
    }
    pio_sm_set_consecutive_pindirs(pio, sm, sck_pin, 1, false);

    pio_sm_config c = tdma_pio_spi_rx_byte_program_get_default_config(offset);
    sm_config_set_in_pins(&c, rx_pin);
    /* Autopush every 8 bits: hardware pushes one byte per 8 SCK cycles, the
     * standard SPI slave pattern. */
    sm_config_set_in_shift(&c, false, true, 8);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void tdma_pio_spi_clk_forward_program_init(PIO pio,
                                                          uint sm,
                                                          uint offset,
                                                          uint rx_clk_pin,
                                                          uint tx_clk_pin)
{
    pio->instr_mem[offset + 0u] =
        (uint16_t)pio_encode_wait_gpio(false, rx_clk_pin);
    pio->instr_mem[offset + 1u] =
        (uint16_t)pio_encode_wait_gpio(true, rx_clk_pin);
    pio->instr_mem[offset + 3u] =
        (uint16_t)pio_encode_wait_gpio(false, rx_clk_pin);

    pio_gpio_init(pio, rx_clk_pin);
    pio_gpio_init(pio, tx_clk_pin);
    gpio_pull_down(rx_clk_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_clk_pin, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_clk_pin, 1, true);

    pio_sm_config c =
        tdma_pio_spi_clk_forward_program_get_default_config(offset);
    sm_config_set_set_pins(&c, tx_clk_pin, 1);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins(pio, sm, 0u);
}

static inline void tdma_pio_spi_clk_burst_program_init(PIO pio,
                                                        uint sm,
                                                        uint offset,
                                                        uint tx_clk_pin,
                                                        uint32_t baud_hz)
{
    const uint32_t effective_baud = baud_hz == 0u ? 1000000u : baud_hz;
    const float clkdiv = (float)clock_get_hz(clk_sys) /
                         (float)(effective_baud * 4u);
    pio_gpio_init(pio, tx_clk_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_clk_pin, 1, true);

    pio_sm_config c =
        tdma_pio_spi_clk_burst_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, tx_clk_pin);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, clkdiv);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins(pio, sm, 0u);
}

static inline void tdma_pio_spi_clk_capture_program_init(PIO pio,
                                                          uint sm,
                                                          uint offset,
                                                          uint rx_clk_pin)
{
    pio->instr_mem[offset + 0u] =
        (uint16_t)pio_encode_wait_gpio(false, rx_clk_pin);
    pio->instr_mem[offset + 1u] =
        (uint16_t)pio_encode_wait_gpio(true, rx_clk_pin);
    pio_gpio_init(pio, rx_clk_pin);
    gpio_pull_down(rx_clk_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_clk_pin, 1, false);

    pio_sm_config c =
        tdma_pio_spi_clk_capture_program_get_default_config(offset);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void tdma_pio_spi_clk_coded_tx_program_init(PIO pio,
                                                           uint sm,
                                                           uint offset,
                                                           uint tx_clk_pin,
                                                           bool idle_high)
{
    pio_gpio_init(pio, tx_clk_pin);
    pio_sm_config c =
        tdma_pio_spi_clk_coded_tx_program_get_default_config(offset);
    sm_config_set_out_pins(&c, tx_clk_pin, 1u);
    sm_config_set_out_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    /* Program the output latch before enabling its direction.  Marker CS is
     * idle high; doing this in the opposite order emits a short false falling
     * edge during persona setup and releases downstream WAIT 0 gates before
     * the DMA-driven marker actually starts. */
    pio_sm_set_pins(pio, sm, idle_high ? 1u : 0u);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_clk_pin, 1u, true);
}

static inline void tdma_pio_spi_marker_origin_program_init(PIO pio,
                                                            uint sm,
                                                            uint offset,
                                                            uint tx_csn_pin)
{
    /* Preserve high-idle across the SIO -> PIO mux handoff.  Preload the PIO
     * output latch before pio_gpio_init exposes it to the enabled driver. */
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << tx_csn_pin,
                                1ull << tx_csn_pin);
    pio_gpio_init(pio, tx_csn_pin);
    pio_sm_config c =
        tdma_pio_spi_marker_origin_program_get_default_config(offset);
    sm_config_set_out_pins(&c, tx_csn_pin, 1u);
    sm_config_set_out_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << tx_csn_pin,
                                1ull << tx_csn_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_csn_pin, 1u, true);
}

static inline void tdma_pio_spi_clk_oversample_program_init(PIO pio,
                                                             uint sm,
                                                             uint offset,
                                                             uint rx_clk_pin)
{
    pio_gpio_init(pio, rx_clk_pin);
    gpio_pull_down(rx_clk_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_clk_pin, 1u, false);
    pio_sm_config c =
        tdma_pio_spi_clk_oversample_program_get_default_config(offset);
    sm_config_set_in_pins(&c, rx_clk_pin);
    sm_config_set_in_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}

/* SCK and DATA are trained independently against the same incoming SCK edge.
 * Flight SCK keeps the established WAIT-delay encoding that preserves the
 * trained waveform duty cycle. DATA sampling follows that WAIT with a serial
 * NOP, so its residual excludes both the SCK phase and the NOP's own cycle. */
static inline uint32_t tdma_pio_spi_flight_data_residual_delay_cycles(
    uint32_t sck_phase_delay_cycles, uint32_t data_phase_delay_cycles)
{
    return data_phase_delay_cycles - sck_phase_delay_cycles - 2u;
}

/* The combined raw follower reaches WAIT-low only after its DATA sample. If
 * the physical falling edge has already arrived, remove those consumed cycles
 * from the falling-edge phase so the regenerated SCK keeps one half-period
 * high time. */
static inline uint32_t tdma_pio_spi_flight_sck_falling_delay_cycles(
    uint32_t sck_phase_delay_cycles, uint32_t data_phase_delay_cycles,
    uint32_t half_period_cycles)
{
    if (data_phase_delay_cycles + 1u <= half_period_cycles) {
        return sck_phase_delay_cycles;
    }
    return sck_phase_delay_cycles + half_period_cycles -
        data_phase_delay_cycles - 1u;
}

static inline void tdma_pio_spi_flight_follower_program_init(
    PIO pio, uint sm, uint offset, uint rx_data_pin, uint tx_data_pin,
    uint rx_sck_pin, uint tx_sck_pin, uint32_t sck_phase_delay_cycles,
    uint32_t data_phase_delay_cycles, uint32_t half_period_cycles)
{
    const uint32_t data_residual_delay_cycles =
        tdma_pio_spi_flight_data_residual_delay_cycles(
            sck_phase_delay_cycles, data_phase_delay_cycles);
    const uint32_t sck_falling_delay_cycles =
        tdma_pio_spi_flight_sck_falling_delay_cycles(
            sck_phase_delay_cycles, data_phase_delay_cycles,
            half_period_cycles);
    pio->instr_mem[offset + 5u] =
        (uint16_t)(pio_encode_nop() |
                   pio_encode_sideset(1u, 1u) |
                   pio_encode_delay(data_residual_delay_cycles));
    pio->instr_mem[offset + 4u] =
        (uint16_t)(pio_encode_wait_gpio(true, rx_sck_pin) |
                   pio_encode_sideset(1u, 0u) |
                   pio_encode_delay(sck_phase_delay_cycles));
    pio->instr_mem[offset + 7u] =
        (uint16_t)(pio_encode_wait_gpio(false, rx_sck_pin) |
                   pio_encode_sideset(1u, 1u) |
                   pio_encode_delay(sck_falling_delay_cycles));
    pio_gpio_init(pio, rx_data_pin);
    pio_gpio_init(pio, tx_data_pin);
    pio_gpio_init(pio, rx_sck_pin);
    pio_gpio_init(pio, tx_sck_pin);
    gpio_pull_down(rx_data_pin);
    gpio_pull_down(rx_sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_data_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_sck_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_data_pin, 1u, true);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_sck_pin, 1u, true);

    pio_sm_config c =
        tdma_pio_spi_flight_follower_program_get_default_config(offset);
    sm_config_set_in_pins(&c, rx_data_pin);
    sm_config_set_out_pins(&c, tx_data_pin, 1u);
    sm_config_set_sideset_pins(&c, tx_sck_pin);
    sm_config_set_in_shift(&c, false, false, 32u);
    sm_config_set_out_shift(&c, false, false, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins_with_mask64(
        pio, sm, 0ull,
        (1ull << tx_data_pin) | (1ull << tx_sck_pin));
}

static inline void tdma_pio_spi_flight_process_follower_program_init(
    PIO pio, uint sm, uint offset, uint rx_data_pin, uint tx_data_pin,
    uint rx_csn_pin, uint rx_sck_pin,
    uint32_t sck_phase_delay_cycles, uint32_t data_phase_delay_cycles)
{
    (void)sck_phase_delay_cycles;
    pio->instr_mem[offset + 5u] =
        (uint16_t)pio_encode_wait_gpio(true, rx_csn_pin);
    pio->instr_mem[offset + 11u] =
        (uint16_t)(pio_encode_wait_gpio(true, rx_sck_pin) |
                   pio_encode_delay(data_phase_delay_cycles - 1u));
    pio->instr_mem[offset + 13u] =
        (uint16_t)pio_encode_wait_gpio(false, rx_sck_pin);
    pio_gpio_init(pio, rx_data_pin);
    pio_gpio_init(pio, tx_data_pin);
    pio_gpio_init(pio, rx_csn_pin);
    pio_gpio_init(pio, rx_sck_pin);
    gpio_pull_down(rx_data_pin);
    gpio_pull_up(rx_csn_pin);
    gpio_pull_down(rx_sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_data_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_csn_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_sck_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_data_pin, 1u, true);

    pio_sm_config c =
        tdma_pio_spi_flight_process_follower_program_get_default_config(
            offset);
    sm_config_set_in_pins(&c, rx_data_pin);
    sm_config_set_out_pins(&c, tx_data_pin, 1u);
    sm_config_set_in_shift(&c, false, false, 32u);
    sm_config_set_out_shift(&c, false, false, 32u);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins_with_mask64(
        pio, sm, 0ull,
        1ull << tx_data_pin);
}

static inline void tdma_pio_spi_flight_control_forward_program_init(
    PIO pio, uint sm, uint offset, uint rx_csn_pin, uint rx_sck_pin,
    uint tx_sck_pin, uint tx_csn_pin, uint32_t marker_phase_delay_cycles,
    uint32_t sck_phase_delay_cycles)
{
    pio->instr_mem[offset + 1u] =
        (uint16_t)(pio_encode_wait_gpio(false, rx_csn_pin) |
                   pio_encode_delay(marker_phase_delay_cycles));
    pio->instr_mem[offset + 4u] =
        (uint16_t)(pio_encode_wait_gpio(true, rx_sck_pin) |
                   pio_encode_delay(sck_phase_delay_cycles));
    pio->instr_mem[offset + 6u] =
        (uint16_t)(pio_encode_wait_gpio(false, rx_sck_pin) |
                   pio_encode_delay(sck_phase_delay_cycles));
    pio->instr_mem[offset + 9u] =
        (uint16_t)(pio_encode_wait_gpio(true, rx_csn_pin) |
                   pio_encode_delay(marker_phase_delay_cycles));
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << tx_csn_pin,
                                (1ull << tx_sck_pin) |
                                    (1ull << tx_csn_pin));
    pio_gpio_init(pio, rx_csn_pin);
    pio_gpio_init(pio, rx_sck_pin);
    pio_gpio_init(pio, tx_sck_pin);
    pio_gpio_init(pio, tx_csn_pin);
    gpio_pull_up(rx_csn_pin);
    gpio_pull_down(rx_sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_csn_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_sck_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_sck_pin, 2u, true);

    pio_sm_config c =
        tdma_pio_spi_flight_control_forward_program_get_default_config(offset);
    sm_config_set_set_pins(&c, tx_sck_pin, 2u);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << tx_csn_pin,
                                (1ull << tx_sck_pin) |
                                    (1ull << tx_csn_pin));
}

static inline void tdma_pio_spi_flight_sck_capture_program_init(
    PIO pio, uint sm, uint offset, uint rx_sck_pin)
{
    pio->instr_mem[offset] =
        (uint16_t)pio_encode_wait_gpio(false, rx_sck_pin);
    pio->instr_mem[offset + 1u] =
        (uint16_t)pio_encode_wait_gpio(true, rx_sck_pin);
    pio_gpio_init(pio, rx_sck_pin);
    gpio_pull_down(rx_sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_sck_pin, 1u, false);

    pio_sm_config c =
        tdma_pio_spi_flight_sck_capture_program_get_default_config(offset);
    sm_config_set_in_pins(&c, rx_sck_pin);
    sm_config_set_in_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void tdma_pio_spi_flight_origin_rtt_program_init(
    PIO pio, uint sm, uint offset, uint tx_csn_pin, uint rx_csn_pin)
{
    pio->instr_mem[offset + 2u] =
        (uint16_t)pio_encode_wait_gpio(true, tx_csn_pin);
    pio->instr_mem[offset + 3u] =
        (uint16_t)pio_encode_wait_gpio(false, tx_csn_pin);
    pio_sm_config c =
        tdma_pio_spi_flight_origin_rtt_program_get_default_config(offset);
    sm_config_set_jmp_pin(&c, rx_csn_pin);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void tdma_pio_spi_flight_origin_clock_rx_program_init(
    PIO pio, uint sm, uint offset, uint rx_data_pin, uint tx_sck_pin,
    uint32_t baud_hz)
{
    pio_gpio_init(pio, rx_data_pin);
    pio_gpio_init(pio, tx_sck_pin);
    gpio_pull_down(rx_data_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_data_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_sck_pin, 1u, true);

    pio_sm_config c =
        tdma_pio_spi_flight_origin_clock_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, rx_data_pin);
    sm_config_set_sideset_pins(&c, tx_sck_pin);
    sm_config_set_in_shift(&c, false, true, 8u);
    sm_config_set_clkdiv(&c, tdma_pio_spi_clkdiv_for_baud(baud_hz));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins_with_mask64(pio, sm, 0ull, 1ull << tx_sck_pin);
}

static inline void tdma_pio_spi_flight_origin_data_tx_program_init(
    PIO pio, uint sm, uint offset, uint tx_data_pin, uint rx_data_pin,
    uint rx_csn_pin, uint rx_sck_pin, uint32_t sck_phase_delay_cycles,
    uint32_t data_phase_delay_cycles)
{
    enum {
        FLIGHT_ORIGIN_DATA_WAIT_CSN_HIGH_INSTRUCTION = 0u,
        FLIGHT_ORIGIN_DATA_WAIT_CSN_LOW_INSTRUCTION = 1u,
        FLIGHT_ORIGIN_DATA_WAIT_SCK_LOW_INSTRUCTION = 6u,
        FLIGHT_ORIGIN_DATA_WAIT_SCK_HIGH_INSTRUCTION = 8u,
        FLIGHT_ORIGIN_DATA_PHASE_DELAY_INSTRUCTION = 9u,
    };
    const uint32_t data_residual_delay_cycles =
        tdma_pio_spi_flight_data_residual_delay_cycles(
            sck_phase_delay_cycles, data_phase_delay_cycles);
    pio->instr_mem[
        offset + FLIGHT_ORIGIN_DATA_WAIT_CSN_HIGH_INSTRUCTION] =
        (uint16_t)pio_encode_wait_gpio(true, rx_csn_pin);
    pio->instr_mem[
        offset + FLIGHT_ORIGIN_DATA_WAIT_CSN_LOW_INSTRUCTION] =
        (uint16_t)pio_encode_wait_gpio(false, rx_csn_pin);
    pio->instr_mem[
        offset + FLIGHT_ORIGIN_DATA_WAIT_SCK_LOW_INSTRUCTION] =
        (uint16_t)pio_encode_wait_gpio(false, rx_sck_pin);
    /* Match the follower receive path exactly: keep the trained SCK WAIT
     * encoding, then consume the DATA-only residual before IN. */
    pio->instr_mem[
        offset + FLIGHT_ORIGIN_DATA_WAIT_SCK_HIGH_INSTRUCTION] =
        (uint16_t)(pio_encode_wait_gpio(true, rx_sck_pin) |
                   pio_encode_delay(sck_phase_delay_cycles));
    pio->instr_mem[
        offset + FLIGHT_ORIGIN_DATA_PHASE_DELAY_INSTRUCTION] =
        (uint16_t)(pio_encode_nop() |
                   pio_encode_delay(data_residual_delay_cycles));
    pio_gpio_init(pio, tx_data_pin);
    pio_gpio_init(pio, rx_data_pin);
    pio_gpio_init(pio, rx_csn_pin);
    pio_gpio_init(pio, rx_sck_pin);
    gpio_pull_up(rx_csn_pin);
    gpio_pull_down(rx_sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_data_pin, 1u, true);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_data_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_csn_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_sck_pin, 1u, false);

    pio_sm_config c =
        tdma_pio_spi_flight_origin_data_tx_program_get_default_config(offset);
    sm_config_set_out_pins(&c, tx_data_pin, 1u);
    sm_config_set_in_pins(&c, rx_data_pin);
    sm_config_set_out_shift(&c, false, false, 32u);
    sm_config_set_in_shift(&c, false, true, 8u);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins_with_mask64(pio, sm, 0ull, 1ull << tx_data_pin);
}

static inline void tdma_pio_spi_marker_forward_program_init(
    PIO pio, uint sm, uint offset, uint rx_csn_pin, uint tx_csn_pin,
    uint32_t phase_delay_cycles)
{
    pio->instr_mem[offset + 0u] =
        (uint16_t)pio_encode_wait_gpio(true, rx_csn_pin);
    pio->instr_mem[offset + 1u] = (uint16_t)(
        pio_encode_wait_gpio(false, rx_csn_pin) |
        pio_encode_delay(phase_delay_cycles));
    pio->instr_mem[offset + 3u] = (uint16_t)(
        pio_encode_wait_gpio(true, rx_csn_pin) |
        pio_encode_delay(phase_delay_cycles));
    /* As above, preload high before muxing the driven pin to PIO. */
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << tx_csn_pin,
                                1ull << tx_csn_pin);
    pio_gpio_init(pio, rx_csn_pin);
    pio_gpio_init(pio, tx_csn_pin);
    gpio_pull_up(rx_csn_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_csn_pin, 1u, false);
    pio_sm_config c =
        tdma_pio_spi_marker_forward_program_get_default_config(offset);
    sm_config_set_set_pins(&c, tx_csn_pin, 1u);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    /* Preserve high-idle CS while arming; the latch must be high before OE. */
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << tx_csn_pin,
                                1ull << tx_csn_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_csn_pin, 1u, true);
}

static inline void tdma_pio_spi_marker_capture_program_init(
    PIO pio, uint sm, uint offset, uint tx_csn_pin, uint rx_csn_pin,
    uint32_t phase_delay_cycles)
{
    pio->instr_mem[offset + 0u] =
        (uint16_t)pio_encode_wait_gpio(true, rx_csn_pin);
    pio->instr_mem[offset + 1u] = (uint16_t)(
        pio_encode_wait_gpio(false, rx_csn_pin) |
        pio_encode_delay(phase_delay_cycles));
    pio_gpio_init(pio, tx_csn_pin);
    pio_gpio_init(pio, rx_csn_pin);
    gpio_pull_up(rx_csn_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_csn_pin, 1u, false);
    pio_sm_config c =
        tdma_pio_spi_marker_capture_program_get_default_config(offset);
    sm_config_set_in_pins(&c, tx_csn_pin);
    sm_config_set_in_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void tdma_pio_spi_data_train_source_program_init(
    PIO pio, uint sm, uint offset, uint32_t tx_csn_pin,
    uint32_t tx_data_pin, uint32_t phase_delay_cycles)
{
    enum {
        DATA_TRAIN_SOURCE_WAIT_HIGH_INSTRUCTION = 3u,
        DATA_TRAIN_SOURCE_WAIT_LOW_INSTRUCTION = 4u,
        DATA_TRAIN_SOURCE_PHASE_DELAY_INSTRUCTION = 6u,
    };
    pio->instr_mem[
        offset + DATA_TRAIN_SOURCE_WAIT_HIGH_INSTRUCTION] =
        (uint16_t)pio_encode_wait_gpio(true, tx_csn_pin);
    pio->instr_mem[
        offset + DATA_TRAIN_SOURCE_WAIT_LOW_INSTRUCTION] =
        (uint16_t)pio_encode_wait_gpio(false, tx_csn_pin);
    pio->instr_mem[
        offset + DATA_TRAIN_SOURCE_PHASE_DELAY_INSTRUCTION] = (uint16_t)(
        pio_encode_nop() | pio_encode_delay(phase_delay_cycles - 1u));
    pio_sm_set_pins_with_mask64(pio, sm, 0ull, 1ull << tx_data_pin);
    pio_gpio_init(pio, tx_csn_pin);
    pio_gpio_init(pio, tx_data_pin);
    gpio_pull_up(tx_csn_pin);
    /* PIO pin directions are shared by the block.  tx_sm already owns CS as
     * an output; marking it input from this SM would suppress the physical
     * marker edge.  WAIT may observe the pad without changing its direction. */
    pio_sm_config c =
        tdma_pio_spi_data_train_source_program_get_default_config(offset);
    sm_config_set_out_pins(&c, tx_data_pin, 1u);
    sm_config_set_out_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins_with_mask64(pio, sm, 0ull, 1ull << tx_data_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_data_pin, 1u, true);
}

static inline void tdma_pio_spi_data_train_sink_program_init(
    PIO pio, uint sm, uint offset, uint32_t rx_csn_pin,
    uint32_t rx_data_pin, uint32_t phase_delay_cycles)
{
    pio->instr_mem[offset + 2u] =
        (uint16_t)pio_encode_wait_gpio(true, rx_csn_pin);
    pio->instr_mem[offset + 3u] =
        (uint16_t)pio_encode_wait_gpio(false, rx_csn_pin);
    pio->instr_mem[offset + 5u] = (uint16_t)(
        pio_encode_nop() | pio_encode_delay(phase_delay_cycles - 1u));
    pio_gpio_init(pio, rx_csn_pin);
    pio_gpio_init(pio, rx_data_pin);
    gpio_pull_up(rx_csn_pin);
    gpio_pull_down(rx_data_pin);
    /* The initiator sink observes its local TX CS marker. tx_sm owns that
     * pin as an output, so this SM must not overwrite the shared PIO OE. */
    pio_sm_set_consecutive_pindirs(pio, sm, rx_data_pin, 1u, false);
    pio_sm_config c =
        tdma_pio_spi_data_train_sink_program_get_default_config(offset);
    sm_config_set_in_pins(&c, rx_data_pin);
    sm_config_set_in_shift(&c, true, true, 32u);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void tdma_pio_spi_sck_train_trigger_program_init(
    PIO pio, uint sm, uint offset, uint32_t tx_csn_pin)
{
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << tx_csn_pin,
                                1ull << tx_csn_pin);
    pio_gpio_init(pio, tx_csn_pin);
    pio_sm_config c =
        tdma_pio_spi_sck_train_trigger_program_get_default_config(offset);
    sm_config_set_out_pins(&c, tx_csn_pin, 1u);
    sm_config_set_out_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << tx_csn_pin,
                                1ull << tx_csn_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_csn_pin, 1u, true);
}

static inline void tdma_pio_spi_sck_train_source_program_init(
    PIO pio, uint sm, uint offset, uint32_t tx_csn_pin,
    uint32_t tx_sck_pin, uint32_t phase_delay_cycles)
{
    pio->instr_mem[offset + 4u] =
        (uint16_t)pio_encode_wait_gpio(true, tx_csn_pin);
    pio->instr_mem[offset + 5u] =
        (uint16_t)pio_encode_wait_gpio(false, tx_csn_pin);
    pio->instr_mem[offset + 10u] = (uint16_t)(
        pio_encode_nop() | pio_encode_delay(phase_delay_cycles - 1u));
    pio_sm_set_pins_with_mask64(pio, sm, 0ull, 1ull << tx_sck_pin);
    pio_gpio_init(pio, tx_sck_pin);
    pio_gpio_init(pio, tx_csn_pin);
    gpio_pull_up(tx_csn_pin);
    pio_sm_config c =
        tdma_pio_spi_sck_train_source_program_get_default_config(offset);
    sm_config_set_set_pins(&c, tx_sck_pin, 1u);
    sm_config_set_out_pins(&c, tx_sck_pin, 1u);
    sm_config_set_out_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins_with_mask64(pio, sm, 0ull, 1ull << tx_sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_sck_pin, 1u, true);
}

static inline void tdma_pio_spi_sck_train_sink_program_init(
    PIO pio, uint sm, uint offset, uint32_t rx_sck_pin,
    uint32_t phase_delay_cycles)
{
    pio->instr_mem[offset + 0u] =
        (uint16_t)pio_encode_wait_gpio(false, rx_sck_pin);
    pio->instr_mem[offset + 1u] =
        (uint16_t)pio_encode_wait_gpio(true, rx_sck_pin);
    pio->instr_mem[offset + 2u] =
        (uint16_t)pio_encode_wait_gpio(false, rx_sck_pin);
    pio->instr_mem[offset + 3u] = (uint16_t)(
        pio_encode_nop() | pio_encode_delay(phase_delay_cycles - 1u));
    pio_gpio_init(pio, rx_sck_pin);
    gpio_pull_down(rx_sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_sck_pin, 1u, false);
    pio_sm_config c =
        tdma_pio_spi_sck_train_sink_program_get_default_config(offset);
    sm_config_set_in_pins(&c, rx_sck_pin);
    sm_config_set_in_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}

static inline float tdma_pio_spi_p3_clkdiv_for_baud(uint32_t baud_hz)
{
    const uint32_t effective_baud = baud_hz == 0u ? 10000000u : baud_hz;
    return (float)clock_get_hz(clk_sys) / (float)(effective_baud * 4u);
}

static inline void tdma_pio_spi_p3_initiator_program_init(
    PIO pio, uint sm, uint offset, uint sync_tx_pin, uint forward_tx_pin,
    uint32_t baud_hz)
{
    pio_gpio_init(pio, sync_tx_pin);
    pio_gpio_init(pio, forward_tx_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, sync_tx_pin, 1u, true);
    pio_sm_set_consecutive_pindirs(pio, sm, forward_tx_pin, 1u, true);
    pio_sm_config c =
        tdma_pio_spi_p3_initiator_program_get_default_config(offset);
    sm_config_set_set_pins(&c, sync_tx_pin, 1u);
    sm_config_set_sideset_pins(&c, forward_tx_pin);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, tdma_pio_spi_p3_clkdiv_for_baud(baud_hz));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins(pio, sm, 0u);
}

static inline uint32_t tdma_pio_spi_p3_data_high_cycles(uint32_t baud_hz)
{
    const uint32_t effective_baud = baud_hz == 0u ? 10000000u : baud_hz;
    uint32_t cycles = (clock_get_hz(clk_sys) + effective_baud) /
                      (2u * effective_baud);
    if (cycles == 0u) cycles = 1u;
    if (cycles > 32u) cycles = 32u;
    return cycles;
}

static inline void tdma_pio_spi_p3_responder_program_init(
    PIO pio, uint sm, uint offset, uint sync_rx_pin, uint forward_rx_pin,
    uint data_tx_pin, uint32_t baud_hz)
{
    const uint32_t high_cycles =
        tdma_pio_spi_p3_data_high_cycles(baud_hz);
    pio->instr_mem[offset + 0u] =
        (uint16_t)pio_encode_wait_gpio(false, sync_rx_pin);
    pio->instr_mem[offset + 1u] =
        (uint16_t)pio_encode_wait_gpio(true, sync_rx_pin);
    /* The second input is the selected forward measurement line.  Its
     * physical label may be CLK or CS; the caller supplies the mapping. */
    pio->instr_mem[offset + 2u] =
        (uint16_t)pio_encode_wait_gpio(false, forward_rx_pin);
    pio->instr_mem[offset + 3u] =
        (uint16_t)pio_encode_wait_gpio(true, forward_rx_pin);
    pio->instr_mem[offset + 4u] =
        (uint16_t)(pio_encode_set(pio_pins, 1u) |
                   pio_encode_delay(high_cycles - 1u));
    pio_gpio_init(pio, sync_rx_pin);
    pio_gpio_init(pio, forward_rx_pin);
    pio_gpio_init(pio, data_tx_pin);
    gpio_pull_down(sync_rx_pin);
    gpio_pull_down(forward_rx_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, sync_rx_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, forward_rx_pin, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, data_tx_pin, 1u, true);
    pio_sm_config c =
        tdma_pio_spi_p3_responder_program_get_default_config(offset);
    sm_config_set_set_pins(&c, data_tx_pin, 1u);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins(pio, sm, 0u);
}

static inline void tdma_pio_spi_p3_responder_capture_program_init(
    PIO pio, uint sm, uint offset, uint sync_rx_pin)
{
    /* Sync only opens the capture window.  It is never a measured edge. */
    pio->instr_mem[offset + 0u] =
        (uint16_t)pio_encode_wait_gpio(false, sync_rx_pin);
    pio->instr_mem[offset + 1u] =
        (uint16_t)pio_encode_wait_gpio(true, sync_rx_pin);
    pio_gpio_init(pio, 24u);
    pio_gpio_init(pio, 27u);
    pio_gpio_init(pio, 28u);
    gpio_pull_down(24u);
    gpio_pull_down(27u);
    gpio_pull_down(28u);
    pio_sm_set_consecutive_pindirs(pio, sm, 24u, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, 27u, 2u, false);
    pio_sm_config c =
        tdma_pio_spi_p3_responder_capture_program_get_default_config(offset);
    sm_config_set_in_pins(&c, 24u);
    sm_config_set_in_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void tdma_pio_spi_cal_loopback_tx_program_init(PIO pio,
                                                              uint sm,
                                                              uint offset)
{
    pio_gpio_init(pio, 25u);
    pio_gpio_init(pio, 26u);
    pio_gpio_init(pio, 29u);
    pio_sm_set_consecutive_pindirs(pio, sm, 25u, 2u, true);
    pio_sm_set_consecutive_pindirs(pio, sm, 29u, 1u, true);
    pio_sm_config c =
        tdma_pio_spi_cal_loopback_tx_program_get_default_config(offset);
    sm_config_set_set_pins(&c, 25u, 5u);
    /* The board runs clk_sys at 250 MHz.  A divided 32-cycle SET marker is
     * about 512 ns, long enough to traverse the ISO1452 + RJ45 loopback while
     * remaining well inside the bounded DMA capture window. */
    sm_config_set_clkdiv(&c, 4.0f);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins(pio, sm, 0u);
}

static inline void tdma_pio_spi_cal_loopback_capture_program_init(
    PIO pio, uint sm, uint offset, uint32_t sample_hz)
{
    const uint32_t effective_hz = sample_hz == 0u ? 50000000u : sample_hz;
    /* Match the proven resident RX persona: explicitly mux every returned
     * ISO1452 logic signal into the owning PIO block before sampling it. */
    pio_gpio_init(pio, 24u);
    pio_gpio_init(pio, 27u);
    pio_gpio_init(pio, 28u);
    gpio_pull_down(24u);
    gpio_pull_down(27u);
    gpio_pull_down(28u);
    /* PIO pin directions are shared by the block.  Do not mark the complete
     * GPIO24..29 sample window as input here: that would undo the TX SM's
     * output ownership of GPIO25/26/29. */
    pio_sm_set_consecutive_pindirs(pio, sm, 24u, 1u, false);
    pio_sm_set_consecutive_pindirs(pio, sm, 27u, 2u, false);
    pio_sm_config c =
        tdma_pio_spi_cal_loopback_capture_program_get_default_config(offset);
    sm_config_set_in_pins(&c, 24u);
    sm_config_set_in_shift(&c, true, true, 32u);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c,
                         (float)clock_get_hz(clk_sys) / (float)effective_hz);
    pio_sm_init(pio, sm, offset, &c);
}

/* Full-duplex master init: out pins = MOSI, side-set = SCK, in pins = MISO.
 * The SM shifts the TX byte out on MOSI while sampling MISO into the RX FIFO
 * on the same clock exchange. */
static inline void tdma_pio_spi_fd_master_program_init(PIO pio,
                                                       uint sm,
                                                       uint offset,
                                                       uint mosi_pin,
                                                       uint sck_pin,
                                                       uint miso_pin,
                                                       uint32_t baud_hz)
{
    pio_gpio_init(pio, mosi_pin);
    pio_gpio_init(pio, sck_pin);
    pio_gpio_init(pio, miso_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, mosi_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, sck_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, miso_pin, 1, false);
    gpio_pull_down(miso_pin);

    pio_sm_config c = tdma_pio_spi_fd_master_program_get_default_config(offset);
    sm_config_set_out_pins(&c, mosi_pin, 1);
    sm_config_set_sideset_pins(&c, sck_pin);
    sm_config_set_in_pins(&c, miso_pin);
    sm_config_set_out_shift(&c, false, false, 32);
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);
    sm_config_set_clkdiv(&c, tdma_pio_spi_clkdiv_for_baud(baud_hz));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins(pio, sm, 0);
}

/* Full-duplex slave init: in pins = MOSI, out pins = MISO, sck sampled on
 * gpio. The SM samples the master's MOSI and drives the response byte on MISO
 * during the same exchange. */
static inline void tdma_pio_spi_fd_slave_program_init(PIO pio,
                                                      uint sm,
                                                      uint offset,
                                                      uint mosi_pin,
                                                      uint sck_pin,
                                                      uint miso_pin)
{
    pio->instr_mem[offset + 0u] = (uint16_t)pio_encode_nop();
    pio->instr_mem[offset + 3u] = (uint16_t)pio_encode_wait_gpio(true, sck_pin);
    pio->instr_mem[offset + 6u] = (uint16_t)pio_encode_wait_gpio(false, sck_pin);

    pio_gpio_init(pio, mosi_pin);
    pio_gpio_init(pio, sck_pin);
    pio_gpio_init(pio, miso_pin);
    gpio_pull_down(mosi_pin);
    gpio_pull_down(sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, mosi_pin, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, sck_pin, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, miso_pin, 1, true);

    pio_sm_config c = tdma_pio_spi_fd_slave_program_get_default_config(offset);
    sm_config_set_in_pins(&c, mosi_pin);
    sm_config_set_out_pins(&c, miso_pin, 1);
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_out_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);
    pio_sm_init(pio, sm, offset, &c);
}

%}
