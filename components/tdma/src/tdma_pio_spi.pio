.program tdma_pio_spi_tx_byte
.side_set 1

.wrap_target
    pull block        side 0
    set x, 7         side 0
bitloop:
    ; Ten PIO cycles per bit: five low then five high.  DATA changes three
    ; cycles before the rising sampling edge and remains stable through the
    ; complete high phase.  This produces an exact 50% duty cycle at the
    ; requested baud instead of the previous 5-low/2-high seven-cycle bit.
    out pins, 1      side 0 [2]
    nop              side 1 [4]
    jmp x-- bitloop  side 0 [1]
.wrap

.program tdma_pio_spi_rx_byte

; Standard pico-examples-style SPI slave receive loop: sample MOSI on SCK high,
; autopush every 8 bits (in_shift autopush threshold = 8). No manual X counter
; -- the hardware shifts and pushes each byte, so the byte boundary cannot
; drift with loop timing.
.wrap_target
    wait 0 gpio 0
    wait 1 gpio 1
    in pins, 1
    wait 0 gpio 1
.wrap

; Full-duplex master: drives SCK + MOSI while sampling MISO on the same
; exchange. Each byte is pulled from TX FIFO, shifted out on MOSI, sampled on
; MISO and pushed to RX FIFO (one SPI transfer per byte).
.program tdma_pio_spi_fd_master
.side_set 1
.wrap_target
    pull block        side 0
    set x, 7          side 0
bitloop_fd:
    out pins, 1       side 0 [1]
    in pins, 1        side 1 [1]
    jmp x-- bitloop_fd side 0 [1]
    push block        side 0
.wrap

; Full-duplex slave: samples MOSI on the master clock while driving MISO with
; the response byte from TX FIFO (one SPI transfer per byte).
.program tdma_pio_spi_fd_slave
.wrap_target
    wait 0 gpio 0
    pull block
    set x, 7
bitloop_fds:
    wait 1 gpio 1
    in pins, 1
    out pins, 1
    wait 0 gpio 1
    jmp x-- bitloop_fds
    push block
.wrap

% c-sdk {

#include <stdint.h>

#include "hardware/clocks.h"
#include "hardware/pio_instructions.h"

static inline float tdma_pio_spi_clkdiv_for_baud(uint32_t baud_hz)
{
    const uint32_t bit_cycles = 10u;
    const uint32_t effective_baud = baud_hz == 0u ? 25000000u : baud_hz;
    return (float)clock_get_hz(clk_sys) / (float)(effective_baud * bit_cycles);
}

static inline void tdma_pio_spi_tx_byte_program_init(PIO pio,
                                                     uint sm,
                                                     uint offset,
                                                     uint tx_pin,
                                                     uint sck_pin,
                                                     uint32_t baud_hz)
{
    pio_gpio_init(pio, tx_pin);
    pio_gpio_init(pio, sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, tx_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, sck_pin, 1, true);

    pio_sm_config c = tdma_pio_spi_tx_byte_program_get_default_config(offset);
    sm_config_set_out_pins(&c, tx_pin, 1);
    sm_config_set_sideset_pins(&c, sck_pin);
    sm_config_set_out_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, tdma_pio_spi_clkdiv_for_baud(baud_hz));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins(pio, sm, 0);
}

static inline void tdma_pio_spi_rx_byte_program_init(PIO pio,
                                                     uint sm,
                                                     uint offset,
                                                     uint rx_pin,
                                                     uint csn_pin,
                                                     uint sck_pin)
{
    /* Standard autopush layout: instruction 0 is the CS wait (patched to
     * nop on the ring), 1 is "wait SCK high", 3 is "wait SCK low". */
    pio->instr_mem[offset + 0u] =
        csn_pin == UINT32_MAX
            ? (uint16_t)pio_encode_nop()
            : (uint16_t)pio_encode_wait_gpio(false, csn_pin);
    pio->instr_mem[offset + 1u] = (uint16_t)pio_encode_wait_gpio(true, sck_pin);
    pio->instr_mem[offset + 3u] = (uint16_t)pio_encode_wait_gpio(false, sck_pin);

    pio_gpio_init(pio, rx_pin);
    if (csn_pin != UINT32_MAX) {
        pio_gpio_init(pio, csn_pin);
    }
    pio_gpio_init(pio, sck_pin);
    gpio_pull_down(rx_pin);
    if (csn_pin != UINT32_MAX) {
        gpio_pull_up(csn_pin);
    }
    gpio_pull_down(sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, rx_pin, 1, false);
    if (csn_pin != UINT32_MAX) {
        pio_sm_set_consecutive_pindirs(pio, sm, csn_pin, 1, false);
    }
    pio_sm_set_consecutive_pindirs(pio, sm, sck_pin, 1, false);

    pio_sm_config c = tdma_pio_spi_rx_byte_program_get_default_config(offset);
    sm_config_set_in_pins(&c, rx_pin);
    /* Autopush every 8 bits: hardware pushes one byte per 8 SCK cycles, the
     * standard SPI slave pattern. */
    sm_config_set_in_shift(&c, false, true, 8);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    pio_sm_init(pio, sm, offset, &c);
}

/* Full-duplex master init: out pins = MOSI, side-set = SCK, in pins = MISO.
 * The SM shifts the TX byte out on MOSI while sampling MISO into the RX FIFO
 * on the same clock exchange. */
static inline void tdma_pio_spi_fd_master_program_init(PIO pio,
                                                       uint sm,
                                                       uint offset,
                                                       uint mosi_pin,
                                                       uint sck_pin,
                                                       uint miso_pin,
                                                       uint32_t baud_hz)
{
    pio_gpio_init(pio, mosi_pin);
    pio_gpio_init(pio, sck_pin);
    pio_gpio_init(pio, miso_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, mosi_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, sck_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, miso_pin, 1, false);
    gpio_pull_down(miso_pin);

    pio_sm_config c = tdma_pio_spi_fd_master_program_get_default_config(offset);
    sm_config_set_out_pins(&c, mosi_pin, 1);
    sm_config_set_sideset_pins(&c, sck_pin);
    sm_config_set_in_pins(&c, miso_pin);
    sm_config_set_out_shift(&c, false, false, 32);
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);
    sm_config_set_clkdiv(&c, tdma_pio_spi_clkdiv_for_baud(baud_hz));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pins(pio, sm, 0);
}

/* Full-duplex slave init: in pins = MOSI, out pins = MISO, sck sampled on
 * gpio. The SM samples the master's MOSI and drives the response byte on MISO
 * during the same exchange. */
static inline void tdma_pio_spi_fd_slave_program_init(PIO pio,
                                                      uint sm,
                                                      uint offset,
                                                      uint mosi_pin,
                                                      uint sck_pin,
                                                      uint miso_pin)
{
    pio->instr_mem[offset + 0u] = (uint16_t)pio_encode_nop();
    pio->instr_mem[offset + 3u] = (uint16_t)pio_encode_wait_gpio(true, sck_pin);
    pio->instr_mem[offset + 6u] = (uint16_t)pio_encode_wait_gpio(false, sck_pin);

    pio_gpio_init(pio, mosi_pin);
    pio_gpio_init(pio, sck_pin);
    pio_gpio_init(pio, miso_pin);
    gpio_pull_down(mosi_pin);
    gpio_pull_down(sck_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, mosi_pin, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, sck_pin, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, miso_pin, 1, true);

    pio_sm_config c = tdma_pio_spi_fd_slave_program_get_default_config(offset);
    sm_config_set_in_pins(&c, mosi_pin);
    sm_config_set_out_pins(&c, miso_pin, 1);
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_out_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);
    pio_sm_init(pio, sm, offset, &c);
}

%}
