      "binaryDir": "${sourceDir}/build-multicore-smoke",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PICO_BOARD": "pico2",
        "PROJECT_ENABLE_USB_STDIO": "ON",
