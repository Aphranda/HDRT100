      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PICO_BOARD": "pico2",
        "PROJECT_ENABLE_USB_STDIO": "ON",
        "PROJECT_ENABLE_UART_STDIO": "ON",
        "PROJECT_ENABLE_LOG_UART_OUTPUT": "OFF",
        "PROJECT_WARNINGS_AS_ERRORS": "ON",
        "PROJECT_ENABLE_OTA_FAULT_INJECTION": "ON",
        "PROJECT_OTA_DEFAULT_BOOT_MODE": "DIRECT_AB",
        "PROJECT_USE_FREERTOS": "ON",
        "PROJECT_USE_MULTICORE": "ON"
