{
  "version": 6,
  "configurePresets": [
    {
      "name": "pico2-release",
      "displayName": "Pico 2 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "pico2",
        "PROJECT_ENABLE_USB_STDIO": "ON",
        "PROJECT_ENABLE_UART_STDIO": "OFF",
        "PROJECT_ENABLE_LOG_UART_OUTPUT": "ON",
        "PROJECT_WARNINGS_AS_ERRORS": "ON",
        "PROJECT_ENABLE_OTA_FAULT_INJECTION": "OFF",
        "PROJECT_OTA_DEFAULT_BOOT_MODE": "DIRECT_AB",
        "PROJECT_USE_FREERTOS": "ON",
        "PROJECT_USE_MULTICORE": "ON"
      }
    },
    {
      "name": "pico2-validation",
      "displayName": "Pico 2 Validation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-validation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "pico2",
        "PROJECT_ENABLE_USB_STDIO": "ON",
        "PROJECT_ENABLE_UART_STDIO": "OFF",
