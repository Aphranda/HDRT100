#!/bin/sh
# Route the staged change set to the credential its class requires:
#   firmware -> P3 hardware acceptance receipt (bench evidence)
#   host     -> host acceptance receipt (pytest evidence)
#   docs     -> docs_check + doc_regression (no receipt)
# tools/acceptance/credential_scope.py owns the mapping; this file only routes.
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1

# Fail closed: if the classifier cannot run, the commit must not bypass gates.
classes="$(python tools/acceptance/credential_scope.py --staged --classes)"
echo "[pre-commit] credential classes: ${classes:-none}"

needs_docs=0
needs_firmware_gate=0
needs_host_gate=0
for name in $classes; do
    case "$name" in
        docs) needs_docs=1 ;;
        firmware) needs_firmware_gate=1 ;;
        host) needs_host_gate=1 ;;
    esac
done

if [ "$needs_docs" -eq 1 ] || [ "${FORCE_DOC_GATES:-0}" = "1" ]; then
echo "[pre-commit] docs_check..."
python tools/docs_check/docs_check.py --strict-names || {
    echo "docs_check FAILED - fix docs before committing"
    exit 1
}
echo "[pre-commit] doc_regression..."
python tools/doc_regression_check.py || {
    echo "doc_regression FAILED - fix docs before committing"
    exit 1
}
echo "[pre-commit] doc gates OK"
fi

if [ "$needs_firmware_gate" -eq 1 ]; then
    echo "[pre-commit] hardware acceptance (P3 receipt or T2 sequence run)..."
    python tools/hardware_acceptance/workflow_steps.py check-staged || {
        echo "hardware acceptance FAILED - run the T2 sequence workflow to a PASS (tools/sync_trigger/sequence_workflow.py), or the P3 gate"
        exit 1
    }
    echo "[pre-commit] hardware acceptance OK"
else
    echo "[pre-commit] P3 hardware gate skipped (no firmware-scope changes)"
fi

if [ "$needs_host_gate" -eq 1 ]; then
    echo "[pre-commit] workflow triage (tools must be judged)..."
    python tools/tool_governance/workflow_triage.py check --quiet || {
        echo "workflow triage FAILED - judge the tool in tools/tool_workflow_triage.json"
        exit 1
    }
    echo "[pre-commit] host acceptance (host test receipt)..."
    python tools/acceptance/host_acceptance.py check-staged || {
        echo "host acceptance FAILED - run python tools/acceptance/host_acceptance.py run and stage the receipt"
        exit 1
    }
    echo "[pre-commit] host acceptance OK"
fi

doc_verify_last="$(git rev-parse --git-path doc-verify-last)"
# P3: never clobber the escape-hatch marker with an empty value. Hooks are also
# invoked with a minimal PATH (IDE/GUI clients, sandboxes) where coreutils `date`
# is missing; an empty marker makes `--log-check` report "cannot read marker" and
# silently destroys the C3 bypass trail. Fall back to the python already required
# by this hook, and keep the previous marker if no clock is available at all.
stamp="$(date +%s 2>/dev/null || python -c 'import time; print(int(time.time()))' 2>/dev/null || true)"
if [ -n "$stamp" ]; then
    echo "$stamp" > "$doc_verify_last"
fi
exit 0
